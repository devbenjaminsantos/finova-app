SA_PASSWORD=TroqueEstaSenha@123

# Use somente para uma implantação operacional controlada; mantenha false no uso normal.
Database__ApplyMigrationsOnStartup=false
# Conexão administrativa exclusiva para executar migrations; não reutilize a conexão de runtime.
ConnectionStrings__Migration=Host=seu-host-neon;Database=neondb;Username=role_de_migration;Password=troque-esta-senha;SSL Mode=Require

# E-mail transacional (o remetente deve estar verificado na Brevo)
Email__Enabled=false
Email__Provider=Brevo
Brevo__ApiKey=xkeysib-substitua_por_uma_chave_de_envio
Brevo__FromEmail=remetente-verificado@seu-dominio.com
Brevo__FromName=Héstia
Brevo__TimeoutSeconds=8

# JWT
Jwt__Audience=Finova
Jwt__Issuer=Finova
Jwt__Key=SUA_CHAVE_JWT_COM_PELO_MENOS_32_CARACTERES
